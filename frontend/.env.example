VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Local dev: leave empty — Vite proxies /api to http://127.0.0.1:8081
# Vercel: leave empty locally. On Vercel set API_PROXY_ORIGIN (build copies it into the client bundle). See frontend/DEPLOY.md
# Optional direct API (type Config on Vercel, not Secret): VITE_API_URL=https://your-service.onrender.com
VITE_API_URL=
