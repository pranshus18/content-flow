VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Local dev: leave empty — Vite proxies /api to http://127.0.0.1:8081
# Vercel option A (direct): VITE_API_URL=https://your-service.onrender.com (public in bundle; confirm in Vercel UI)
# Vercel option B (proxy): leave empty; set server-only API_PROXY_ORIGIN on Vercel (see middleware.ts)
VITE_API_URL=
