PORT=8081
FRONTEND_ORIGIN=http://localhost:8080
# Production (Vercel): your live app URL, e.g. https://content-flow.vercel.app
# FRONTEND_ORIGIN=https://your-app.vercel.app
# Optional: preview branches (comma-separated)
# FRONTEND_EXTRA_ORIGINS=https://content-flow-git-main-you.vercel.app
# API-only on Render when UI is on Vercel — do not enable unless you serve dist from Express
# SERVE_FRONTEND=false

# Supabase (same project as the frontend — keep it for Auth, Postgres, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: Postgres URI from Supabase → Settings → Database (needed to apply migrations)
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: protect the scheduled-publish cron and internal calls
CRON_SECRET=change-me

# Caption + media enhancement
GEMINI_API_KEY=
# Photos: gemini-nano-banana-2.1. Video: gemini-omni-1.1-flash. Captions: gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Video / photo upscaling fallback
REPLICATE_API_TOKEN=

# Social publishing + analytics
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY_STATUS=unlisted
